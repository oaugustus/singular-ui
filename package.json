{
  "name": "gravity-elements",
  "version": "0.1.0",
  "description": "Biblioteca de componentes UI para AngularJS 1.8.3 (Gravity Elements), portando o design system do Nuxt UI",
  "license": "MIT",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "bundle:tv-shim": "esbuild node_modules/tailwind-variants/dist/index.js --bundle --format=iife --global-name=TailwindVariants --outfile=test/shims/tailwind-variants.iife.js",
    "test": "npm run bundle:tv-shim && karma start test/karma.conf.js --single-run",
    "generate:safelist": "node scripts/generate-tailwind-safelist.js",
    "build:css": "npm run generate:safelist && tailwindcss -i ./src/styles/gravity-elements.css -o ./dist/gravity-elements.css --minify",
    "demo": "vite"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "angular": "1.8.3",
    "angular-animate": "1.8.3",
    "angular-aria": "1.8.3",
    "date-fns": "^4.4.0",
    "focus-trap": "^7.8.0",
    "mousetrap": "^1.6.5",
    "tabbable": "^6.5.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "eslint-plugin-angular": "^4.1.0",
    "jasmine-core": "^6.3.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-jasmine": "^5.1.0",
    "postcss": "^8.5.26",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21"
  }
}
